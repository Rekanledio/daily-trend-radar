# ============================================================================
# Daily Trend Radar — .gitignore
# ============================================================================

# ---- Node.js / Next.js ----
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/
*.egg-info/
pip-wheel-metadata/

# ---- Environment / Secrets ----
.env
.env.local
.env.*.local
!.env.example

# ---- IDE / Editor ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Logs / Temp ----
*.log
logs/
.tmp/
.cache/

# ---- Agent internal state (not project source, do not publish) ----
.workbuddy/

# ---- Local runtime data (Local-first / Self-hosted) ----
# Pipeline writes dynamic run artifacts here and the frontend reads them
# from localhost. These are USER-LOCAL generated data and must NOT enter
# the Git repository (repo publishes code + config only). Covers:
#   data/YYYY/...      daily shards (e.g. data/2026/07/2026-07-25.json)
#   data/index.json     run index
#   data/health.json   run health
#   data/sources_state.json  per-source run state
# NOTE: files already tracked before this rule was added remain tracked;
# to untrack them without deleting locally, use `git rm --cached`
# (requires explicit human approval — not done automatically).
/data/
