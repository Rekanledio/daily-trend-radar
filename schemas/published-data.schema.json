{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-trend-radar.dev/schemas/published-data.schema.json",
  "title": "PublishedData",
  "description": "data/YYYY/MM/YYYY-MM-DD.json 每日发布数据。每个板块最多 20 条，不足不凑数。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date", "schema_version", "generated_at", "pipeline_version",
    "ai_enabled", "categories", "trends", "events", "metadata"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "数据日期 YYYY-MM-DD"
    },
    "schema_version": { "type": "string", "minLength": 1 },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "生成时间，ISO 8601 UTC"
    },
    "pipeline_version": {
      "type": "string",
      "minLength": 1,
      "description": "Pipeline 版本（与 pyproject 一致），用于追溯"
    },
    "ai_enabled": {
      "type": "boolean",
      "description": "本次运行是否启用了 AI 加工"
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count", "items"],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "description": "该板块实际条数（= items 长度）"
          },
          "items": {
            "type": "array",
            "items": { "$ref": "trend.schema.json" },
            "maxItems": 20
          }
        }
      },
      "description": "按分类分组的热点；每个板块 ≤20 条"
    },
    "trends": {
      "type": "array",
      "items": { "$ref": "trend.schema.json" },
      "description": "全部已发布 Trend 的扁平集合（= 各板块 items 的并集）"
    },
    "events": {
      "type": "array",
      "items": { "$ref": "event.schema.json" },
      "description": "聚合事件集合（MVP 可为空）"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["run_summary"],
      "properties": {
        "run_summary": { "$ref": "#/$defs/RunSummary" }
      },
      "description": "运行元信息，至少含 run_summary"
    }
  },
  "$defs": {
    "RunSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources_ok", "sources_failed", "total_dropped"],
      "properties": {
        "sources_ok": { "type": "integer", "minimum": 0 },
        "sources_failed": { "type": "integer", "minimum": 0 },
        "total_dropped": { "type": "integer", "minimum": 0 },
        "generated_by": {
          "type": ["string", "null"],
          "description": "生成环境标识（如 github-actions / local）"
        }
      }
    }
  }
}
